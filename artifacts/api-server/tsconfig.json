{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["../../lib/db/src"],
      "@workspace/db/*": ["../../lib/db/src/*"],
      "@workspace/api-zod": ["../../lib/api-zod/src"],
      "@workspace/api-zod/*": ["../../lib/api-zod/src/*"],
      "@workspace/integrations-gemini-ai": ["../../lib/integrations-gemini-ai/src"],
      "@workspace/integrations-gemini-ai/*": ["../../lib/integrations-gemini-ai/src/*"]
    }
  },
  "include": ["src"],
  
}
